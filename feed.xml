---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{% assign announcements = site.news | sort: 'date' | reverse %}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | default: 'en' }}">
  <title>SCALE Lab news</title>
  <subtitle>News from SCALE Lab at Washington State University.</subtitle>
  <id>{{ '/feed.xml' | absolute_url | xml_escape }}</id>
  <link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/news/' | absolute_url | xml_escape }}" rel="alternate" type="text/html" />
  <updated>{{ announcements.first.date | default: site.time | date_to_xmlschema }}</updated>
  <author><name>SCALE Lab</name></author>
  {% for item in announcements limit: 50 %}
  <entry>
    <title>{{ item.content | strip_html | normalize_whitespace | truncate: 120 | xml_escape }}</title>
    <id>{{ item.url | absolute_url | xml_escape }}</id>
    <link href="{{ item.url | absolute_url | xml_escape }}" rel="alternate" type="text/html" />
    <published>{{ item.date | date_to_xmlschema }}</published>
    <updated>{{ item.date | date_to_xmlschema }}</updated>
    <content type="html">{{ item.content | markdownify | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
